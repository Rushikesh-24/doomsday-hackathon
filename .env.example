# Copy to .env (same folder) and fill in. .env is git-ignored; real environment variables override it.

# --- AI assistant (Groq) ------------------------------------------------------------------------------
# Server-side only: the mobile app and web app talk to /assistant/chat, the key is never sent to clients.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: preferred model. If it is unavailable for your key, the server picks the best available one.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Server ---------------------------------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser ("*" = any, fine for a LAN demo).
CORS_ORIGINS=*
# Optional shared secret for write operations from the mobile app / other clients (publishing maps,
# job controls). Leave empty on a trusted LAN; set it when the API is reachable from the internet.
ACCESSMAP_API_TOKEN=

# --- Vision engine ----------------------------------------------------------------------------------------
# VISION_DEVICE=auto            # auto | cuda | mps | cpu
# VISION_PRELOAD=1              # load the detector at startup
# VISION_OFFLINE=0              # 1 = never download model weights

# Brush splat backend: macOS arm64 binary only. Leave unset on Windows/Linux (the PyTorch backend is used).
# VISION_BRUSH_BIN=tools/brush/brush-app-aarch64-apple-darwin/brush_app
