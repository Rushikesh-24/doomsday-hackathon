        "api.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8002"
      ],
      "port": 8002,
      "env": {
        "VISION_PRELOAD": "0",
        "VISION_OUTPUT_DIR": "C:\\Users\\HP\\AppData\\Local\\Temp\\claude\\890e60988e539f60\\7a436827-63d8-4467-9a08-eb03d5f0dded\\scratchpad\\bdemo"
      }
